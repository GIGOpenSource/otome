# 复制本文件为 .env 后再填写。不要把填好的 .env 提交到仓库。

DJANGO_SECRET_KEY=change-me

# compose 内 Postgres 服务名；不要填公网 IP
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=otome
POSTGRES_USER=otome
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=public

# compose 内 Redis；密码不能为空
REDIS_PASSWORD=change-me

OTOME_ADMIN_KEY=change-me
OTOME_ADMIN_USER=admin
OTOME_ADMIN_PASSWORD=change-me
OTOME_ADMIN_EMAIL=admin@example.com
OTOME_FRONTEND_BASE=https://example.com
# 必须是 16、24 或 32 字节
OTOME_TOKEN_KEY=change-me-16chars

# 对象存储：1=GCS，2=COS（默认），3=MinIO。上传后直接返回公开 URL，nginx 不再反代 MinIO。
STORAGE_BACKEND=2

# COS（STORAGE_BACKEND=2）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
# 可选自定义域名，不填则用 https://{bucket}.cos.{region}.myqcloud.com/
COS_DOMAIN=

# GCS（STORAGE_BACKEND=1）
GCS_BUCKET=
GCS_CREDENTIALS=/app/certs/google-service-account.json
GCS_PUBLIC_BASE_URL=

# MinIO（STORAGE_BACKEND=3）
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=0
MINIO_PUBLIC_BASE=
